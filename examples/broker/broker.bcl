broker "complete" {
  # Production should set insecure_dev false and provide real tokens/TLS.
  addr env("BROKER_ADDR", ":8090")
  mode "standalone"
  default_queue "default"
  wal env("BROKER_WAL", "./.broker-data/wal")
  wal_format env("BROKER_WAL_FORMAT", "binary")
  insecure_dev env("BROKER_INSECURE_DEV", "true")
  log_events true
  debug_events false
  max_body "4MB"
  default_visibility "30s"
  remote_consumer_timeout "45s"

  # Optional persistent message data-plane store for queues/topics/streams/DLQ/leases.
  message_store "sqlite" {
    enabled env("BROKER_SQLITE_MESSAGE_ENABLED", "false")
    driver env("BROKER_SQLITE_DRIVER", "sqlite")
    dsn env("BROKER_SQLITE_MESSAGE_DSN", "./.broker-data/broker-messages.sqlite")
  }

  # Optional persistent control-plane state store for broker/task/consumer/publisher state.
  state_store "sqlite" {
    enabled env("BROKER_SQLITE_STATE_ENABLED", "false")
    driver env("BROKER_SQLITE_DRIVER", "sqlite")
    dsn env("BROKER_SQLITE_DSN", "./.broker-data/broker-state.sqlite")
  }

  codec "fwb1" {
    max_frame_size env("BROKER_FRAME_MAX", "128MB")
    compress_threshold env("BROKER_FRAME_COMPRESS_THRESHOLD", "1KB")
    signing_key env("BROKER_FRAME_SIGNING_KEY", "dev-frame-signing-key")
    encryption_key env("BROKER_FRAME_ENCRYPTION_KEY", "")
  }

  observer_jsonl env("BROKER_OBSERVER_JSONL", "./.broker-data/observability/broker-events.jsonl")

  callback "live-jsonl-audit" {
    enabled true
    type "notification"
    sink "jsonl"
    path env("BROKER_OBSERVER_JSONL", "./.broker-data/observability/broker-events.jsonl")
    events ["broker.*", "consumer.*", "message.*", "task.*", "queue.*", "stream.*", "dlq.*", "admin.*"]
  }

  token "admin" {
    value env("BROKER_TOKEN", "dev-admin-token")
    permissions ["admin:*"]
  }

  token "publisher" {
    value env("BROKER_PUBLISHER_TOKEN", "dev-publisher-token")
    permissions ["publish", "task:write", "task:read", "broker:read", "stream:read", "message:read", "dlq:read"]
  }

  token "worker" {
    value env("BROKER_WORKER_TOKEN", "dev-worker-token")
    permissions ["broker:read", "consumer:register", "consumer:read", "consumer:control", "consumer:poll", "message:read", "message:ack", "message:nack", "task:read", "task:write", "dlq:read", "notification"]
  }

  # =========================================================================
  # Core resources
  # =========================================================================

  topic "email.created" {
    partitions 1
    retention "24h"
  }

  topic "tenant.*.invoice.created" {
    partitions 4
    retention "24h"
  }

  queue "email.send" {
    dlq "email.send.dlq"
    visibility_timeout "30s"
    max_attempts 3
    max_depth 100000
    backpressure "reject"
  }

  queue "invoice.events" {
    dlq "invoice.events.dlq"
    visibility_timeout "30s"
    max_attempts 3
  }

  queue "tasks.pdf.generate" {
    dlq "tasks.pdf.generate.dlq"
    visibility_timeout "45s"
    max_attempts 3
  }

  queue "codec.frames" {
    dlq "codec.frames.dlq"
    visibility_timeout "30s"
    max_attempts 3
  }

  queue "request.payment.authorize" {
    dlq "request.payment.authorize.dlq"
    visibility_timeout "20s"
    max_attempts 3
  }

  queue "command.payment.capture" {
    dlq "command.payment.capture.dlq"
    visibility_timeout "20s"
    max_attempts 3
  }

  stream "audit.events" {
    partitions 1
    retention "24h"
  }

  route "email-created-to-send-queue" {
    match "email.created"
    to queue "email.send"
    copy_to stream "audit.events"
  }

  route "invoice-wildcard-to-consumer-queue" {
    match "tenant.*.invoice.created"
    to queue "invoice.events"
    copy_to stream "audit.events"
  }

  # =========================================================================
  # Routing strategy queues with strategy configuration
  # =========================================================================

  queue "strategy.roundrobin" {
    dlq "strategy.roundrobin.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "round_robin"
  }

  queue "strategy.weighted" {
    dlq "strategy.weighted.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "weighted_round_robin"
  }

  queue "strategy.leastloaded" {
    dlq "strategy.leastloaded.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "least_loaded"
  }

  queue "strategy.random" {
    dlq "strategy.random.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "random"
  }

  queue "strategy.consistenthash" {
    dlq "strategy.consistenthash.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "consistent_hash"
  }

  queue "strategy.capability" {
    dlq "strategy.capability.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "capability_based"
  }

  queue "strategy.priority" {
    dlq "strategy.priority.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "priority_aware"
  }

  queue "strategy.adaptive" {
    dlq "strategy.adaptive.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "adaptive_load_balance"
  }

  queue "strategy.sticky" {
    dlq "strategy.sticky.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "sticky_session"
  }

  queue "strategy.fanout" {
    dlq "strategy.fanout.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "fan_out"
  }

  queue "strategy.p2c" {
    dlq "strategy.p2c.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "power_of_two_choices"
  }

  queue "strategy.sharded" {
    dlq "strategy.sharded.dlq"
    visibility_timeout "10s"
    max_attempts 3
    strategy "sharded"
  }

  queue "strategy.route.high" {
    dlq "strategy.route.high.dlq"
    visibility_timeout "10s"
    max_attempts 3
  }

  queue "strategy.route.low" {
    dlq "strategy.route.low.dlq"
    visibility_timeout "10s"
    max_attempts 3
  }

  queue "strategy.bcl.ml" {
    dlq "strategy.bcl.ml.dlq"
    visibility_timeout "10s"
    max_attempts 3
  }

  queue "strategy.bcl.text" {
    dlq "strategy.bcl.text.dlq"
    visibility_timeout "10s"
    max_attempts 3
  }

  # =========================================================================
  # Strategy routes
  # =========================================================================

  route "strategy-high-priority" {
    match "strategy.route.*"
    to queue "strategy.route.high"
    priority_min 5
  }

  route "strategy-low-priority" {
    match "strategy.route.*"
    to queue "strategy.route.low"
  }

  topic "strategy.events" {
    partitions 1
    retention "1h"
  }

  route "strategy-events-fanout" {
    match "strategy.events.*"
    to queue "strategy.fanout"
  }
}
